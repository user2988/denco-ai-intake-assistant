# Anthropic API Key — required for Claude intake generation
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Neon Postgres — required for persistent intake storage
# Get your connection string from https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=your_neon_database_url_here

# Automation API Key — optional, but recommended for production
# Protects POST /api/intakes from unauthenticated callers (e.g. Zapier).
# If set, requests must include the header:  X-Automation-Key: <value>
# Leave unset in local dev to skip the check.
AUTOMATION_API_KEY=your_secret_key_here
